# Copy to .env (gitignored) and fill in.

# OpenFi executor / router authority keypair (devnet). Must hold devnet SOL and USDC.
OPENFI_KEY=~/.config/solana/openfi-devnet.json
SOLANA_RPC=https://api.devnet.solana.com

# Flick open banking sandbox (bank debits) and its webhook signing.
BANK_API_BASE=http://127.0.0.1:43181
WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_HEADER=
WEBHOOK_TIMESTAMP_HEADER=
PORT=8788
